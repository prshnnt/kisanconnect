-- ============================================================================
-- KisanConnect eNAM DATABASE SCHEMA (38-Table Consolidated ORM Specification)
-- ============================================================================
-- Consolidated Database Schema matching backend FastAPI + SQLAlchemy 2.0 ORM Models:
-- 1. Reference & Geo Data (states, districts, tehsils, apmcs, commodities, commodity_varieties, bag_types)
-- 2. Core Shared & Polymorphic (addresses, attachments, commodity_links, number_sequences)
-- 3. Identity, Auth & Users (users, bank_accounts, sellers, buyers, trade_licenses, otp_challenges, refresh_tokens)
-- 4. Agmarknet & Market Intelligence (daily_market_prices)
-- 5. Service Marketplace (service_providers, provider_services, service_catalogs, service_bookings, equipment, weighment_records)
-- 6. Trade Lifecycle & APMC (commission_agents, epermits, lots, supplies, demands, auctions, auction_bids, trades, sale_bills, gate_exits, charge_rules, bill_charges, settlements)
-- ============================================================================

-- ============================================================================
-- 1. REFERENCE & GEO DATA
-- ============================================================================

CREATE TABLE states (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) UNIQUE NOT NULL,
    code VARCHAR(10)
);

CREATE TABLE districts (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    state_id BIGINT NOT NULL,
    name VARCHAR(100) NOT NULL,
    FOREIGN KEY (state_id) REFERENCES states(id),
    INDEX idx_districts_state_id (state_id)
);

CREATE TABLE tehsils (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    district_id BIGINT NOT NULL,
    name VARCHAR(100) NOT NULL,
    FOREIGN KEY (district_id) REFERENCES districts(id),
    INDEX idx_tehsils_district_id (district_id)
);

CREATE TABLE apmcs (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(200) NOT NULL,
    state_id BIGINT NOT NULL,
    district_id BIGINT,
    apmc_type VARCHAR(20) NOT NULL DEFAULT 'enam', -- enam | non_enam
    address TEXT,
    latitude DECIMAL(9, 6),
    longitude DECIMAL(9, 6),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (state_id) REFERENCES states(id),
    FOREIGN KEY (district_id) REFERENCES districts(id),
    INDEX idx_apmcs_name (name),
    INDEX idx_apmcs_state_id (state_id),
    INDEX idx_apmcs_district_id (district_id)
);

CREATE TABLE commodities (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(150) NOT NULL,
    code VARCHAR(50),
    category VARCHAR(100),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_commodities_name (name)
);

CREATE TABLE commodity_varieties (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    commodity_id BIGINT NOT NULL,
    name VARCHAR(150) NOT NULL,
    FOREIGN KEY (commodity_id) REFERENCES commodities(id),
    INDEX idx_commodity_varieties_commodity_id (commodity_id)
);

CREATE TABLE bag_types (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    material VARCHAR(50),
    weight_kg DECIMAL(10, 2) NOT NULL
);

-- ============================================================================
-- 2. CORE SHARED & POLYMORPHIC TABLES
-- ============================================================================

-- Address table replaces user, lot, demand, supply, provider, warehouse & location tables
CREATE TABLE addresses (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    owner_type VARCHAR(30) NOT NULL, -- user | seller | buyer | lot | supply | demand | provider | catalog | license | booking | agreement | bill
    owner_id BIGINT NOT NULL,
    kind VARCHAR(30) NOT NULL, -- permanent | current | service_area | preferred | lot | delivery | pickup | drop
    line1 VARCHAR(255),
    line2 VARCHAR(255),
    pincode VARCHAR(10),
    state_id BIGINT,
    district_id BIGINT,
    tehsil_id BIGINT,
    apmc_id BIGINT,
    city VARCHAR(150),
    latitude DECIMAL(9, 6),
    longitude DECIMAL(9, 6),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (state_id) REFERENCES states(id),
    FOREIGN KEY (district_id) REFERENCES districts(id),
    FOREIGN KEY (tehsil_id) REFERENCES tehsils(id),
    FOREIGN KEY (apmc_id) REFERENCES apmcs(id),
    INDEX ix_addresses_owner (owner_type, owner_id, kind),
    INDEX idx_addresses_state_id (state_id),
    INDEX idx_addresses_apmc_id (apmc_id)
);

-- Attachments table replaces all certificate, license, invoice & photo join tables
CREATE TABLE attachments (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    owner_type VARCHAR(30), -- NULL until linked (presigned upload)
    owner_id BIGINT,
    kind VARCHAR(40), -- licence | certificate | report | invoice_pdf | photo
    file_name VARCHAR(255) NOT NULL,
    file_url TEXT NOT NULL,
    mime_type VARCHAR(100),
    size_bytes BIGINT,
    uploaded_by BIGINT,
    uploaded_at TIMESTAMP WITH TIME ZONE,
    FOREIGN KEY (uploaded_by) REFERENCES users(id) ON DELETE SET NULL,
    INDEX ix_attachments_owner (owner_type, owner_id)
);

-- CommodityLinks table handles preferred commodities, expertise & handled items
CREATE TABLE commodity_links (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    owner_type VARCHAR(30) NOT NULL,
    owner_id BIGINT NOT NULL,
    commodity_id BIGINT NOT NULL,
    role VARCHAR(30) NOT NULL DEFAULT 'preferred', -- preferred | expertise | handled
    FOREIGN KEY (commodity_id) REFERENCES commodities(id) ON DELETE CASCADE,
    UNIQUE KEY uq_commodity_link (owner_type, owner_id, commodity_id, role),
    INDEX idx_commodity_links_commodity_id (commodity_id)
);

-- Atomic counter sequence behind human-readable document IDs
CREATE TABLE number_sequences (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    prefix VARCHAR(60) UNIQUE NOT NULL,
    last BIGINT NOT NULL DEFAULT 0
);

-- ============================================================================
-- 3. IDENTITY, AUTHENTICATION & USERS
-- ============================================================================

CREATE TABLE users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    uuid VARCHAR(36) UNIQUE NOT NULL DEFAULT (gen_random_uuid()),
    user_type VARCHAR(30) NOT NULL DEFAULT 'individual', -- individual | institutional
    organization_name VARCHAR(200),
    registered_apmc_id BIGINT,
    first_name VARCHAR(100) NOT NULL,
    middle_name VARCHAR(100),
    last_name VARCHAR(100),
    guardian_relation VARCHAR(10), -- s/o | d/o | w/o
    guardian_name VARCHAR(200),
    date_of_birth DATE,
    gender VARCHAR(20), -- male | female | other
    mobile VARCHAR(20) UNIQUE NOT NULL,
    alt_mobile VARCHAR(20),
    email VARCHAR(255) UNIQUE,
    mobile_verified BOOLEAN NOT NULL DEFAULT FALSE,
    email_verified BOOLEAN NOT NULL DEFAULT FALSE,
    roles TEXT[], -- seller, buyer, commission_agent, service_provider, admin
    password_hash VARCHAR(255),
    failed_logins INT NOT NULL DEFAULT 0,
    locked_until TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP NULL,
    FOREIGN KEY (registered_apmc_id) REFERENCES apmcs(id)
);

CREATE TABLE bank_accounts (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    account_number VARCHAR(50) NOT NULL,
    ifsc VARCHAR(20) NOT NULL,
    holder_name VARCHAR(200),
    bank_name VARCHAR(200),
    is_verified BOOLEAN NOT NULL DEFAULT FALSE,
    is_primary BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    INDEX idx_bank_accounts_user_id (user_id)
);

CREATE TABLE sellers (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT UNIQUE NOT NULL,
    seller_type VARCHAR(30) NOT NULL DEFAULT 'farmer', -- farmer | fpo
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE TABLE buyers (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT UNIQUE NOT NULL,
    organization VARCHAR(200),
    contact_person VARCHAR(150),
    gstin VARCHAR(20),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    INDEX idx_buyers_organization (organization)
);

CREATE TABLE trade_licenses (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    buyer_id BIGINT NOT NULL,
    issuing_state_id BIGINT,
    issuing_apmc_id BIGINT,
    operating_state_id BIGINT,
    operating_apmc_id BIGINT,
    is_unified BOOLEAN NOT NULL DEFAULT FALSE,
    apmc_type VARCHAR(20) NOT NULL DEFAULT 'enam',
    number VARCHAR(100) NOT NULL,
    issued_on DATE,
    expires_on DATE,
    status VARCHAR(20) NOT NULL DEFAULT 'active', -- active | expired | suspended
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (buyer_id) REFERENCES buyers(id) ON DELETE CASCADE,
    FOREIGN KEY (issuing_state_id) REFERENCES states(id),
    FOREIGN KEY (issuing_apmc_id) REFERENCES apmcs(id),
    FOREIGN KEY (operating_state_id) REFERENCES states(id),
    FOREIGN KEY (operating_apmc_id) REFERENCES apmcs(id),
    UNIQUE KEY uq_buyer_license_number (buyer_id, number),
    INDEX idx_trade_licenses_buyer_id (buyer_id),
    INDEX idx_trade_licenses_operating_state_id (operating_state_id),
    INDEX idx_trade_licenses_operating_apmc_id (operating_apmc_id)
);

CREATE TABLE otp_challenges (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    target VARCHAR(255) NOT NULL, -- mobile or email
    purpose VARCHAR(30) NOT NULL, -- login | register | verify_mobile | verify_email | delete_account | reset_password
    code_hash VARCHAR(128) NOT NULL,
    attempts INT NOT NULL DEFAULT 0,
    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,
    consumed_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_otp_challenges_target (target)
);

CREATE TABLE refresh_tokens (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    token_hash VARCHAR(128) UNIQUE NOT NULL,
    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,
    revoked_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    INDEX idx_refresh_tokens_user_id (user_id)
);

-- ============================================================================
-- 4. AGMARKNET & MARKET INTELLIGENCE
-- ============================================================================

CREATE TABLE daily_market_prices (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    commodity_id BIGINT NOT NULL,
    state_id BIGINT,
    district_id BIGINT,
    apmc_id BIGINT,
    price_date DATE NOT NULL,
    min_price DECIMAL(15, 2),
    max_price DECIMAL(15, 2),
    modal_price DECIMAL(15, 2),
    quantity DECIMAL(15, 2),
    source VARCHAR(50) NOT NULL DEFAULT 'agmarknet_ceda',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (commodity_id) REFERENCES commodities(id) ON DELETE CASCADE,
    FOREIGN KEY (state_id) REFERENCES states(id) ON DELETE SET NULL,
    FOREIGN KEY (district_id) REFERENCES districts(id) ON DELETE SET NULL,
    FOREIGN KEY (apmc_id) REFERENCES apmcs(id) ON DELETE SET NULL,
    UNIQUE KEY uq_daily_market_price_apmc_commodity_date (apmc_id, commodity_id, price_date),
    INDEX idx_daily_market_prices_commodity_id (commodity_id),
    INDEX idx_daily_market_prices_state_id (state_id),
    INDEX idx_daily_market_prices_district_id (district_id),
    INDEX idx_daily_market_prices_apmc_id (apmc_id),
    INDEX idx_daily_market_prices_price_date (price_date),
    INDEX ix_daily_market_prices_lookup (state_id, district_id, commodity_id, price_date)
);

-- ============================================================================
-- 5. SERVICE MARKETPLACE (Weighment, Logistics, Warehouse, Assaying)
-- ============================================================================

CREATE TABLE service_providers (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT UNIQUE NOT NULL,
    business_name VARCHAR(200),
    notify_by_phone BOOLEAN NOT NULL DEFAULT TRUE,
    notify_by_email BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE TABLE provider_services (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    provider_id BIGINT NOT NULL,
    service_type VARCHAR(30) NOT NULL, -- weighment | warehouse | logistics | assaying | assurance | packaging | grading | labour
    shop_name VARCHAR(200),
    license_number VARCHAR(100),
    license_expires_on DATE,
    response_time VARCHAR(40),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    details JSONB NOT NULL DEFAULT '{}',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (provider_id) REFERENCES service_providers(id) ON DELETE CASCADE,
    UNIQUE KEY uq_provider_service_type (provider_id, service_type),
    INDEX idx_provider_services_provider_id (provider_id)
);

CREATE TABLE service_catalogs (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    provider_service_id BIGINT NOT NULL,
    service_type VARCHAR(30) NOT NULL,
    name VARCHAR(200) NOT NULL,
    venue VARCHAR(30) NOT NULL DEFAULT 'outside_apmc', -- inside_apmc | outside_apmc
    apmc_id BIGINT,
    state_id BIGINT,
    commodity_id BIGINT,
    variety_id BIGINT,
    price_unit VARCHAR(30) NOT NULL DEFAULT 'per_sample',
    base_price DECIMAL(15, 2),
    min_price DECIMAL(15, 2) NOT NULL,
    max_price DECIMAL(15, 2) NOT NULL,
    is_negotiable BOOLEAN NOT NULL DEFAULT FALSE,
    turnaround VARCHAR(100),
    operating_hours VARCHAR(100),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    details JSONB NOT NULL DEFAULT '{}',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (provider_service_id) REFERENCES provider_services(id) ON DELETE CASCADE,
    FOREIGN KEY (apmc_id) REFERENCES apmcs(id),
    FOREIGN KEY (state_id) REFERENCES states(id),
    FOREIGN KEY (commodity_id) REFERENCES commodities(id),
    FOREIGN KEY (variety_id) REFERENCES commodity_varieties(id),
    INDEX idx_service_catalogs_provider_service_id (provider_service_id),
    INDEX idx_service_catalogs_service_type (service_type),
    INDEX idx_service_catalogs_venue (venue),
    INDEX idx_service_catalogs_apmc_id (apmc_id),
    INDEX idx_service_catalogs_state_id (state_id),
    INDEX idx_service_catalogs_commodity_id (commodity_id),
    INDEX ix_catalog_search (service_type, venue, state_id, is_active)
);

CREATE TABLE service_bookings (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    catalog_id BIGINT NOT NULL,
    service_type VARCHAR(30) NOT NULL,
    seeker_id BIGINT NOT NULL,
    provider_id BIGINT NOT NULL,
    lot_id BIGINT,
    venue VARCHAR(30) NOT NULL,
    is_free BOOLEAN NOT NULL DEFAULT FALSE,
    scheduled_on DATE,
    time_slot VARCHAR(50),
    quantity_qtl DECIMAL(15, 2),
    quoted_price DECIMAL(15, 2),
    offered_price DECIMAL(15, 2),
    counter_price DECIMAL(15, 2),
    final_price DECIMAL(15, 2),
    negotiation VARCHAR(30) NOT NULL DEFAULT 'na', -- na | requested | countered | accepted | rejected
    status VARCHAR(30) NOT NULL DEFAULT 'requested', -- requested | negotiating | accepted | in_progress | completed | cancelled | rejected
    payment_status VARCHAR(30) NOT NULL DEFAULT 'pending', -- pending | partial | paid | overdue | failed
    completed_at TIMESTAMP WITH TIME ZONE,
    notes TEXT,
    details JSONB NOT NULL DEFAULT '{}',
    history JSONB NOT NULL DEFAULT '[]',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (catalog_id) REFERENCES service_catalogs(id),
    FOREIGN KEY (seeker_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (provider_id) REFERENCES service_providers(id),
    FOREIGN KEY (lot_id) REFERENCES lots(id) ON DELETE SET NULL,
    INDEX idx_service_bookings_catalog_id (catalog_id),
    INDEX idx_service_bookings_service_type (service_type),
    INDEX idx_service_bookings_seeker_id (seeker_id),
    INDEX idx_service_bookings_provider_id (provider_id),
    INDEX idx_service_bookings_status (status),
    INDEX ix_booking_provider_status (provider_id, status)
);

CREATE TABLE equipment (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    provider_service_id BIGINT NOT NULL,
    name VARCHAR(150) NOT NULL,
    kind VARCHAR(50), -- weigh_bridge | scale | nir
    capacity_tonnes DECIMAL(10, 2),
    serial_number VARCHAR(100),
    calibration_cert_no VARCHAR(100),
    calibration_expires_on DATE,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (provider_service_id) REFERENCES provider_services(id) ON DELETE CASCADE,
    INDEX idx_equipment_provider_service_id (provider_service_id),
    INDEX idx_equipment_calibration_expires_on (calibration_expires_on)
);

CREATE TABLE weighment_records (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    slip_number VARCHAR(50) UNIQUE NOT NULL,
    booking_id BIGINT,
    lot_id BIGINT,
    vehicle_number VARCHAR(50) NOT NULL,
    bag_type_id BIGINT,
    number_of_bags INT,
    gross_kg DECIMAL(15, 2) NOT NULL,
    tare_kg DECIMAL(15, 2) NOT NULL,
    bag_deduction_kg DECIMAL(10, 2) NOT NULL DEFAULT 0,
    final_qtl DECIMAL(15, 2) NOT NULL,
    operator VARCHAR(100),
    equipment_id BIGINT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (booking_id) REFERENCES service_bookings(id) ON DELETE SET NULL,
    FOREIGN KEY (lot_id) REFERENCES lots(id) ON DELETE SET NULL,
    FOREIGN KEY (bag_type_id) REFERENCES bag_types(id),
    FOREIGN KEY (equipment_id) REFERENCES equipment(id) ON DELETE SET NULL,
    INDEX idx_weighment_records_lot_id (lot_id),
    INDEX idx_weighment_records_vehicle_number (vehicle_number)
);

-- ============================================================================
-- 6. TRADE LIFECYCLE, AUCTIONS & APMC SETTLEMENTS
-- ============================================================================

CREATE TABLE commission_agents (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT UNIQUE,
    apmc_id BIGINT NOT NULL,
    firm_name VARCHAR(200) NOT NULL,
    agent_name VARCHAR(150) NOT NULL,
    license_number VARCHAR(100),
    mobile VARCHAR(20),
    commission_pct DECIMAL(5, 2),
    license_expires_on DATE,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL,
    FOREIGN KEY (apmc_id) REFERENCES apmcs(id),
    INDEX idx_commission_agents_apmc_id (apmc_id),
    INDEX idx_commission_agents_firm_name (firm_name)
);

CREATE TABLE epermits (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    buyer_id BIGINT,
    source_state_id BIGINT,
    source_apmc_id BIGINT,
    commodity_id BIGINT,
    quantity_qtl DECIMAL(15, 2),
    valid_until DATE,
    status VARCHAR(20) NOT NULL DEFAULT 'issued', -- issued | used | expired | cancelled
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (buyer_id) REFERENCES buyers(id) ON DELETE SET NULL,
    FOREIGN KEY (source_state_id) REFERENCES states(id),
    FOREIGN KEY (source_apmc_id) REFERENCES apmcs(id),
    FOREIGN KEY (commodity_id) REFERENCES commodities(id)
);

CREATE TABLE lots (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    seller_id BIGINT NOT NULL,
    lot_type VARCHAR(30) NOT NULL, -- advance | outside_apmc
    sale_type VARCHAR(30) NOT NULL DEFAULT 'primary', -- primary | secondary
    status VARCHAR(30) NOT NULL DEFAULT 'draft', -- draft | active | auctioned | sold | cancelled | expired
    commodity_id BIGINT NOT NULL,
    variety_id BIGINT,
    speciality VARCHAR(255),
    bag_type_id BIGINT,
    bags INT,
    quantity_qtl DECIMAL(15, 2) NOT NULL,
    min_price DECIMAL(15, 2),
    apmc_id BIGINT,
    commission_agent_id BIGINT,
    vehicle_type VARCHAR(100),
    vehicle_number VARCHAR(50),
    delivery_mode VARCHAR(30), -- delivery | pickup
    epermit_id BIGINT,
    source_state_id BIGINT,
    source_apmc_id BIGINT,
    is_enam_trade BOOLEAN,
    fee_applicable BOOLEAN NOT NULL DEFAULT FALSE,
    bid_start_at TIMESTAMP WITH TIME ZONE,
    bid_duration_min INT,
    result_after TIMESTAMP WITH TIME ZONE,
    is_closed_bid BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (seller_id) REFERENCES sellers(id) ON DELETE CASCADE,
    FOREIGN KEY (commodity_id) REFERENCES commodities(id),
    FOREIGN KEY (variety_id) REFERENCES commodity_varieties(id),
    FOREIGN KEY (bag_type_id) REFERENCES bag_types(id),
    FOREIGN KEY (apmc_id) REFERENCES apmcs(id),
    FOREIGN KEY (commission_agent_id) REFERENCES commission_agents(id),
    FOREIGN KEY (epermit_id) REFERENCES epermits(id),
    FOREIGN KEY (source_state_id) REFERENCES states(id),
    FOREIGN KEY (source_apmc_id) REFERENCES apmcs(id),
    INDEX idx_lots_seller_id (seller_id),
    INDEX idx_lots_status (status),
    INDEX idx_lots_commodity_id (commodity_id),
    INDEX idx_lots_apmc_id (apmc_id),
    INDEX ix_lots_seller_status (seller_id, status)
);

CREATE TABLE supplies (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    seller_id BIGINT NOT NULL,
    commodity_id BIGINT NOT NULL,
    variety_id BIGINT,
    quantity_qtl DECIMAL(15, 2) NOT NULL,
    expected_price DECIMAL(15, 2),
    available_from DATE NOT NULL,
    available_to DATE NOT NULL,
    delivery_mode VARCHAR(30) NOT NULL,
    contact_by_phone BOOLEAN NOT NULL DEFAULT TRUE,
    contact_by_email BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (seller_id) REFERENCES sellers(id) ON DELETE CASCADE,
    FOREIGN KEY (commodity_id) REFERENCES commodities(id),
    FOREIGN KEY (variety_id) REFERENCES commodity_varieties(id),
    INDEX idx_supplies_seller_id (seller_id),
    INDEX idx_supplies_commodity_id (commodity_id)
);

CREATE TABLE demands (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    buyer_id BIGINT NOT NULL,
    is_advance BOOLEAN NOT NULL DEFAULT TRUE,
    commodity_id BIGINT NOT NULL,
    variety_id BIGINT,
    min_qty_qtl DECIMAL(15, 2) NOT NULL,
    max_qty_qtl DECIMAL(15, 2),
    min_price DECIMAL(15, 2),
    max_price DECIMAL(15, 2),
    deliver_by DATE,
    status VARCHAR(20) NOT NULL DEFAULT 'active', -- draft | active | fulfilled | cancelled | expired
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (buyer_id) REFERENCES buyers(id) ON DELETE CASCADE,
    FOREIGN KEY (commodity_id) REFERENCES commodities(id),
    FOREIGN KEY (variety_id) REFERENCES commodity_varieties(id),
    INDEX idx_demands_buyer_id (buyer_id),
    INDEX idx_demands_commodity_id (commodity_id),
    INDEX idx_demands_status (status)
);

CREATE TABLE auctions (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    lot_id BIGINT UNIQUE NOT NULL,
    status VARCHAR(30) NOT NULL DEFAULT 'scheduled', -- scheduled | live | closed | declared | rejected | cancelled
    is_closed_bid BOOLEAN NOT NULL DEFAULT FALSE,
    is_auto_declare BOOLEAN NOT NULL DEFAULT FALSE,
    min_price DECIMAL(15, 2) NOT NULL,
    reserve_price DECIMAL(15, 2),
    min_increment DECIMAL(15, 2) NOT NULL DEFAULT 1,
    starts_at TIMESTAMP WITH TIME ZONE NOT NULL,
    ends_at TIMESTAMP WITH TIME ZONE NOT NULL,
    result_after TIMESTAMP WITH TIME ZONE,
    h1_price DECIMAL(15, 2),
    h1_bid_id BIGINT,
    bid_count INT NOT NULL DEFAULT 0,
    bidder_count INT NOT NULL DEFAULT 0,
    winning_buyer_id BIGINT,
    winning_price DECIMAL(15, 2),
    declared_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (lot_id) REFERENCES lots(id) ON DELETE CASCADE,
    FOREIGN KEY (winning_buyer_id) REFERENCES buyers(id) ON DELETE SET NULL,
    INDEX ix_auctions_status_end (status, ends_at)
);

CREATE TABLE auction_bids (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    auction_id BIGINT NOT NULL,
    buyer_id BIGINT NOT NULL,
    price DECIMAL(15, 2) NOT NULL,
    status VARCHAR(30) NOT NULL DEFAULT 'active', -- active | outbid | winning | rejected
    idempotency_key VARCHAR(64) UNIQUE,
    placed_at TIMESTAMP WITH TIME ZONE NOT NULL,
    FOREIGN KEY (auction_id) REFERENCES auctions(id) ON DELETE CASCADE,
    FOREIGN KEY (buyer_id) REFERENCES buyers(id) ON DELETE CASCADE,
    INDEX idx_auction_bids_auction_id (auction_id),
    INDEX idx_auction_bids_buyer_id (buyer_id),
    INDEX ix_bids_auction_price (auction_id, price)
);

CREATE TABLE trades (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    agreement_number VARCHAR(50) UNIQUE,
    lot_id BIGINT UNIQUE NOT NULL,
    auction_id BIGINT,
    seller_id BIGINT NOT NULL,
    buyer_id BIGINT NOT NULL,
    commission_agent_id BIGINT,
    commodity_id BIGINT NOT NULL,
    apmc_id BIGINT,
    venue VARCHAR(30) NOT NULL DEFAULT 'inside_apmc', -- inside_apmc | outside_apmc
    bags INT,
    approx_qty_qtl DECIMAL(15, 2) NOT NULL,
    rate_per_qtl DECIMAL(15, 2) NOT NULL,
    weighment_id BIGINT,
    final_qty_qtl DECIMAL(15, 2),
    total_value DECIMAL(15, 2),
    status VARCHAR(30) NOT NULL DEFAULT 'declared', -- declared | confirmed | weighment_pending | agreement_generated | cancelled
    buyer_confirmed_at TIMESTAMP WITH TIME ZONE,
    seller_confirmed_at TIMESTAMP WITH TIME ZONE,
    bid_decision VARCHAR(30) NOT NULL DEFAULT 'pending', -- pending | accepted | rejected
    buyer_approval VARCHAR(30) NOT NULL DEFAULT 'pending', -- pending | approved | rejected
    seller_approval VARCHAR(30) NOT NULL DEFAULT 'pending', -- pending | approved | rejected
    terms TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (lot_id) REFERENCES lots(id) ON DELETE CASCADE,
    FOREIGN KEY (auction_id) REFERENCES auctions(id) ON DELETE SET NULL,
    FOREIGN KEY (seller_id) REFERENCES sellers(id),
    FOREIGN KEY (buyer_id) REFERENCES buyers(id),
    FOREIGN KEY (commission_agent_id) REFERENCES commission_agents(id),
    FOREIGN KEY (commodity_id) REFERENCES commodities(id),
    FOREIGN KEY (apmc_id) REFERENCES apmcs(id),
    FOREIGN KEY (weighment_id) REFERENCES weighment_records(id) ON DELETE SET NULL,
    INDEX idx_trades_seller_id (seller_id),
    INDEX idx_trades_buyer_id (buyer_id),
    INDEX idx_trades_apmc_id (apmc_id),
    INDEX idx_trades_venue (venue),
    INDEX idx_trades_status (status)
);

CREATE TABLE sale_bills (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    invoice_number VARCHAR(50) UNIQUE NOT NULL,
    trade_id BIGINT UNIQUE NOT NULL,
    invoice_date DATE NOT NULL DEFAULT (CURRENT_DATE),
    due_date DATE,
    quantity_qtl DECIMAL(15, 2) NOT NULL,
    rate_per_qtl DECIMAL(15, 2) NOT NULL,
    gross_amount DECIMAL(15, 2) NOT NULL,
    mandi_fee DECIMAL(15, 2) NOT NULL DEFAULT 0,
    commission DECIMAL(15, 2) NOT NULL DEFAULT 0,
    other_charges DECIMAL(15, 2) NOT NULL DEFAULT 0,
    seller_deductions DECIMAL(15, 2) NOT NULL DEFAULT 0,
    seller_net DECIMAL(15, 2) NOT NULL DEFAULT 0,
    tax DECIMAL(15, 2) NOT NULL DEFAULT 0,
    total DECIMAL(15, 2) NOT NULL,
    paid DECIMAL(15, 2) NOT NULL DEFAULT 0,
    payment_status VARCHAR(30) NOT NULL DEFAULT 'pending', -- pending | partial | paid | overdue | failed
    payment_ref VARCHAR(100),
    paid_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (trade_id) REFERENCES trades(id) ON DELETE CASCADE,
    INDEX idx_sale_bills_payment_status (payment_status)
);

CREATE TABLE gate_exits (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    number VARCHAR(50) UNIQUE NOT NULL,
    exit_type VARCHAR(30) NOT NULL, -- post_trade | goods_return
    lot_id BIGINT NOT NULL,
    bill_id BIGINT,
    created_by BIGINT,
    vehicle_type VARCHAR(100),
    vehicle_number VARCHAR(50),
    bags INT,
    quantity_qtl DECIMAL(15, 2),
    return_reason TEXT,
    approval VARCHAR(30) NOT NULL DEFAULT 'pending', -- pending | approved | rejected
    approved_by BIGINT,
    approved_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (lot_id) REFERENCES lots(id) ON DELETE CASCADE,
    FOREIGN KEY (bill_id) REFERENCES sale_bills(id) ON DELETE SET NULL,
    FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE SET NULL,
    FOREIGN KEY (approved_by) REFERENCES users(id) ON DELETE SET NULL,
    INDEX idx_gate_exits_exit_type (exit_type),
    INDEX idx_gate_exits_lot_id (lot_id),
    INDEX idx_gate_exits_approval (approval)
);

CREATE TABLE charge_rules (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    apmc_id BIGINT,
    commodity_id BIGINT,
    kind VARCHAR(30) NOT NULL, -- mandi_fee | commission | hamali | weighment | transport | other
    side VARCHAR(30) NOT NULL, -- buyer | seller
    basis VARCHAR(30) NOT NULL, -- percent | per_bag | per_qtl | flat
    rate DECIMAL(12, 4) NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (apmc_id) REFERENCES apmcs(id) ON DELETE CASCADE,
    FOREIGN KEY (commodity_id) REFERENCES commodities(id) ON DELETE CASCADE,
    INDEX ix_charge_rules_lookup (apmc_id, kind, is_active)
);

CREATE TABLE bill_charges (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    bill_id BIGINT NOT NULL,
    kind VARCHAR(30) NOT NULL,
    side VARCHAR(30) NOT NULL,
    basis VARCHAR(30) NOT NULL,
    rate DECIMAL(12, 4) NOT NULL,
    amount DECIMAL(15, 2) NOT NULL,
    payee VARCHAR(20) NOT NULL, -- mandi | commission_agent | provider
    FOREIGN KEY (bill_id) REFERENCES sale_bills(id) ON DELETE CASCADE,
    INDEX idx_bill_charges_bill_id (bill_id)
);

CREATE TABLE settlements (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    bill_id BIGINT NOT NULL,
    payee_user_id BIGINT,
    payee_role VARCHAR(20) NOT NULL, -- seller | commission_agent | mandi
    amount DECIMAL(15, 2) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'pending', -- pending | paid
    reference VARCHAR(100),
    paid_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (bill_id) REFERENCES sale_bills(id) ON DELETE CASCADE,
    FOREIGN KEY (payee_user_id) REFERENCES users(id) ON DELETE SET NULL,
    UNIQUE KEY uq_settlement_per_role (bill_id, payee_role),
    INDEX idx_settlements_bill_id (bill_id),
    INDEX idx_settlements_payee_user_id (payee_user_id),
    INDEX idx_settlements_status (status)
);

-- ============================================================================
-- END OF CONSOLIDATED 38-TABLE SCHEMA
-- ============================================================================