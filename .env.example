# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kisanconnect

# Connection Strings (for Docker service networking)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kisanconnect
REDIS_URL=redis://redis:6379/0

# Backend Application Settings
ENV=development
JWT_SECRET=dev-only-secret-change-me-before-deploying-0123456789
ACCESS_MINUTES=60
REFRESH_DAYS=14
ADMIN_INVITE_CODE=
DEBUG_OTP=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# External API Keys & Services
OLLAMA_API_KEY=
TAVILY_API_KEY=

# Frontend Client Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
