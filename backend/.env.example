# You do NOT need a .env to try the project: docker-compose.yml has safe DEVELOPMENT defaults built in.
#
# This file documents the settings. Use it when running WITHOUT Docker (uvicorn / pytest read .env), or as the
# template for a real deployment. For production set:
#   ENV=production                     the app then REFUSES to boot with weak settings
#   JWT_SECRET=<32+ random chars>      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   DEBUG_OTP=false
#   CORS_ORIGINS=["https://your-frontend.example.com"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kisanconnect
REDIS_URL=redis://localhost:6379/0
ENV=development
JWT_SECRET=dev-only-secret-change-me-before-deploying-0123456789
ACCESS_MINUTES=60
REFRESH_DAYS=14
ADMIN_INVITE_CODE=
DEBUG_OTP=true
CORS_ORIGINS=["http://localhost:3000"]
